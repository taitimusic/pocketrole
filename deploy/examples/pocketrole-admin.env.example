# PocketRole hosted admin service environment

POCKETROLE_ADMIN_HOST=127.0.0.1
POCKETROLE_ADMIN_PORT=8787
POCKETROLE_ADMIN_CONFIG=/var/www/pocketrole/pocketrole/config.yaml
POCKETROLE_ADMIN_DB=/var/www/pocketrole/pocketrole/db/pocketrole.db
POCKETROLE_ADMIN_ARCHIVE_ROOT=/var/www/pocketrole/pocketrole/web/published
POCKETROLE_ADMIN_USER=replace_me
POCKETROLE_ADMIN_PASSWORD=replace_me_with_strong_password
POCKETROLE_ADMIN_COOKIE_SECURE=1
WEB_AUTH_TOKEN=replace_me_with_receiver_token
