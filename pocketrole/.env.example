# .env.example
# このファイルをコピーして .env として使用してください:
#   cp .env.example .env
# ※ .env はリポジトリ管理対象外（.gitignore に追加済み）

# === Web送信 ===
WEB_RECEIVER_URL=https://example.com/sandbox/receiver.php
WEB_AUTH_TOKEN=your_secret_token_here

# === LLM APIキー（使用するプロバイダーのみ設定すればよい） ===
OPENAI_API_KEY=sk-...
ANTHROPIC_API_KEY=sk-ant-...
GEMINI_API_KEY=AIza...
DEEPSEEK_API_KEY=sk-...

# === Ollama（ローカル。デフォルトのまま使うなら省略可） ===
# OLLAMA_BASE_URL=http://localhost:11434
